{
	"name": "template-minimal-jsx-app",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently -k -n BUILD,SERVE -c blue,green \"tsup --sourcemap inline --watch\" \"serve dist -l 8080 --cors\"",
		"build": "tsup",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"format": "biome check --write ./src",
		"lint": "biome check ./src"
	},
	"author": "Nuvemshop / Tiendanube",
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@tiendanube/nube-sdk-ui": "^0.24.0",
		"@tiendanube/nube-sdk-jsx": "^0.22.0",
		"@tiendanube/nube-sdk-signals": "^0.1.0",
		"@tiendanube/nube-sdk-types": "^0.111.0",
		"@tiendanube/nube-sdk-helper": "^0.5.0",
		"@vitest/coverage-v8": "^4.1.12",
		"concurrently": "^9.1.2",
		"serve": "^14.2.4",
		"tsup": "^8.3.0",
		"typescript": "^5.6.2",
		"vitest": "^4.1.12"
	},
	"overrides": {
		"compression": "^1.8.2"
	},
	"resolutions": {
		"compression": "^1.8.2"
	}
}
